PORT=4000
JWT_SECRET=change-me-to-a-long-random-string

# Строка подключения к Postgres (Neon или Supabase, бесплатный план).
# Взять в дашборде проекта: Neon — Connection string; Supabase — Project Settings -> Database -> Connection string (URI).
DATABASE_URL=postgres://user:password@host:5432/dbname

# Публичный адрес фронтенда — нужен для og:-превью в WhatsApp/Telegram, sitemap.xml
# и ссылки в письме подтверждения email. Локально можно не задавать.
PUBLIC_URL=https://your-frontend.netlify.app

# Домены, которым разрешены запросы к API (через запятую, если несколько).
# Не задан — CORS открыт для всех origin (удобно для локальной разработки).
CORS_ORIGIN=https://your-frontend.netlify.app

# Resend (resend.com) для писем подтверждения email — Render блокирует
# исходящий SMTP, поэтому письма шлём через HTTP API. Если не задать —
# ссылка на подтверждение просто печатается в консоль сервера (удобно локально).
RESEND_API_KEY=re_xxx
SMTP_FROM=Шабашка <you@example.com>

# Импорт объявлений через Telegram-бота (см. README). Без TELEGRAM_BOT_TOKEN и
# TELEGRAM_ADMIN_IDS бот просто не запускается, сайт работает как раньше.
# Ключ Groq — бесплатный, без карты, берётся на https://console.groq.com/keys
GROQ_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_IDS=

# Необязательно: ID канала, куда бот сам постит опубликованные объявления
# (бот должен быть админом канала). Без неё этот шаг просто пропускается.
TELEGRAM_CHANNEL_ID=

# Необязательно: автопостинг ролика в Instagram. Без них бот пришлёт готовый
# mp4 в чат — выложить вручную.
INSTAGRAM_USER_ID=
INSTAGRAM_ACCESS_TOKEN=

# Необязательно: тот же ролик в Threads. Доступ отдельный от инстаграмного —
# свой профиль в приложении Meta и свой токен, даже если аккаунт один и тот же.
THREADS_USER_ID=
THREADS_ACCESS_TOKEN=

# Автоимпорт вакансий из чужого Telegram-канала (без ручной пересылки), см.
# README, раздел «Автоимпорт из канала-источника». Без этих переменных бот
# работает как раньше — только по тому, что прислали ему лично.
#
# TELEGRAM_API_ID и TELEGRAM_API_HASH — с https://my.telegram.org (API development
# tools), от аккаунта, который подписан на канал-источник.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Строка сессии — получить один раз командой `npm run telegram-login` (см. README).
TELEGRAM_SESSION_STRING=
# Канал(ы)-источник: @username или числовой id, через запятую, если несколько.
SOURCE_CHANNEL=
# По умолчанию из канала публикуются только вакансии (канал смешанный, автору
# нужны именно они). SOURCE_LISTING_TYPE=all снимает фильтр и публикует всё,
# что не отсеет сама модель.
SOURCE_LISTING_TYPE=vacancy
# Необязательно: куда слать отчёт о публикации (карточка, кнопка удаления,
# статус по соцсетям). По умолчанию — первый ID из TELEGRAM_ADMIN_IDS.
SOURCE_REPORT_CHAT_ID=
