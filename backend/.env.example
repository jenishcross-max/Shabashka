PORT=4000
JWT_SECRET=change-me-to-a-long-random-string

# Строка подключения к Postgres (Neon или Supabase, бесплатный план).
# Взять в дашборде проекта: Neon — Connection string; Supabase — Project Settings -> Database -> Connection string (URI).
DATABASE_URL=postgres://user:password@host:5432/dbname

# Публичный адрес фронтенда — нужен для og:-превью в WhatsApp/Telegram, sitemap.xml
# и ссылки в письме подтверждения email. Локально можно не задавать.
PUBLIC_URL=https://your-frontend.netlify.app

# Домены, которым разрешены запросы к API (через запятую, если несколько).
# Не задан — CORS открыт для всех origin (удобно для локальной разработки).
CORS_ORIGIN=https://your-frontend.netlify.app

# Resend (resend.com) для писем подтверждения email — Render блокирует
# исходящий SMTP, поэтому письма шлём через HTTP API. Если не задать —
# ссылка на подтверждение просто печатается в консоль сервера (удобно локально).
RESEND_API_KEY=re_xxx
SMTP_FROM=Шабашка <you@example.com>

# Импорт объявлений через Telegram-бота (см. README). Без TELEGRAM_BOT_TOKEN и
# TELEGRAM_ADMIN_IDS бот просто не запускается, сайт работает как раньше.
# Ключ Groq — бесплатный, без карты, берётся на https://console.groq.com/keys
GROQ_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_IDS=

# Необязательно: ID канала, куда бот сам постит опубликованные объявления
# (бот должен быть админом канала). Без неё этот шаг просто пропускается.
TELEGRAM_CHANNEL_ID=

# Необязательно: автопостинг ролика в Instagram по кнопке «Опубликовать».
# Без них бот пришлёт готовый mp4 в чат — выложить вручную.
INSTAGRAM_USER_ID=
INSTAGRAM_ACCESS_TOKEN=
