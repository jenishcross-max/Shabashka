PORT=4000
JWT_SECRET=change-me-to-a-long-random-string

# Строка подключения к Postgres (Neon или Supabase, бесплатный план).
# Взять в дашборде проекта: Neon — Connection string; Supabase — Project Settings -> Database -> Connection string (URI).
DATABASE_URL=postgres://user:password@host:5432/dbname

# Публичный адрес фронтенда — нужен для og:-превью в WhatsApp/Telegram и sitemap.xml.
# Локально можно не задавать.
PUBLIC_URL=https://your-frontend.netlify.app
