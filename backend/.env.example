PORT=4000
JWT_SECRET=change-me-to-a-long-random-string

# Строка подключения к Postgres (Neon или Supabase, бесплатный план).
# Взять в дашборде проекта: Neon — Connection string; Supabase — Project Settings -> Database -> Connection string (URI).
DATABASE_URL=postgres://user:password@host:5432/dbname

# Публичный адрес фронтенда — нужен для og:-превью в WhatsApp/Telegram, sitemap.xml
# и ссылки в письме подтверждения email. Локально можно не задавать.
PUBLIC_URL=https://your-frontend.netlify.app

# Домены, которым разрешены запросы к API (через запятую, если несколько).
# Не задан — CORS открыт для всех origin (удобно для локальной разработки).
CORS_ORIGIN=https://your-frontend.netlify.app

# Resend (resend.com) для писем подтверждения email — Render блокирует
# исходящий SMTP, поэтому письма шлём через HTTP API. Если не задать —
# ссылка на подтверждение просто печатается в консоль сервера (удобно локально).
RESEND_API_KEY=re_xxx
SMTP_FROM=Шабашка <you@example.com>

# Импорт объявлений через Telegram-бота (см. README). Без TELEGRAM_BOT_TOKEN и
# TELEGRAM_ADMIN_IDS бот просто не запускается, сайт работает как раньше.
# Ключ Groq — бесплатный, без карты, берётся на https://console.groq.com/keys
GROQ_API_KEY=
# Необязательно: лесенка моделей разбора через запятую. Суточная норма у Groq
# своя у каждой модели: выбрав одну, бот переходит к следующей. Последняя —
# резерв под платную рекламу: посты из групп её не трогают. По умолчанию
# qwen/qwen3.8-27b,openai/gpt-oss-20b,llama-3.3-70b-versatile,openai/gpt-oss-120b.
# Свои лимиты видно на https://console.groq.com/settings/limits
GROQ_MODELS=
# Необязательно, если не задан GROQ_MODELS: первая ступень лесенки (по умолчанию
# qwen/qwen3.8-27b) и последняя, резервная (по умолчанию openai/gpt-oss-120b).
GROQ_MODEL=
GROQ_BACKUP_MODEL=
# Необязательно: суточная норма токенов на ключ, по умолчанию 200000 — столько
# даёт бесплатный тариф Groq. В заголовках ответа её нет, бот считает сам.
GROQ_DAILY_TOKENS=
# Необязательно: low/medium включает размышления модели — отбор строже, но
# втрое дороже по токенам. По умолчанию none.
GROQ_REASONING=

# Необязательно: запасной шлюз в формате OpenAI (OmniRoute, OpenRouter и т.п.).
# Он не заменяет Groq, а подхватывает перелив: когда у всех ключей Groq минутный
# лимит выбран, разбор уходит туда. Без FALLBACK_MODEL шлюз не включается.
FALLBACK_API_URL=
FALLBACK_MODEL=
FALLBACK_API_KEY=

TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_IDS=
# Необязательно: публичный адрес бэкенда. Локально бот работает длинным опросом,
# на Render — вебхуком, и этот же адрес Instagram использует, чтобы забрать
# ролик. Секрет подписи Render генерирует сам.
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=
# Необязательно: от чьего имени публиковать объявления из бота. По умолчанию —
# первый администратор сайта.
BOT_OWNER_EMAIL=

# Необязательно: ID канала, куда бот сам постит опубликованные объявления
# (бот должен быть админом канала). Без неё этот шаг просто пропускается.
TELEGRAM_CHANNEL_ID=

# Необязательно: автопостинг ролика в Instagram. Без них бот пришлёт готовый
# mp4 в чат — выложить вручную.
INSTAGRAM_USER_ID=
INSTAGRAM_ACCESS_TOKEN=
# Свой суточный потолок публикаций, по умолчанию 10 (Meta разрешает 100, но
# полсотни почти одинаковых роликов в сутки она читает как рассылку и перестаёт
# показывать их неподписчикам — см. README, «Сколько роликов в сутки»). Сутки
# скользящие: место освобождается через 24 часа после каждой публикации.
# Платной рекламы (/ad) этот потолок не касается — она идёт до нормы Meta. Если
# площадка отдаст число меньше — берётся её.
INSTAGRAM_DAILY_LIMIT=
# Как часто выезжает ролик, в минутах; по умолчанию 150. В один ролик едет до
# трёх объявлений одного типа — и выезжает он по времени, а не по наполнению,
# поэтому неполная пачка никого не задерживает.
INSTAGRAM_RELEASE_MINUTES=
# Необязательно: хост Graph API. По умолчанию graph.instagram.com — это доступ
# «Instagram API with Instagram Login», без страницы в Facebook.
INSTAGRAM_GRAPH_HOST=

# Необязательно: тот же ролик в Threads. Доступ отдельный от инстаграмного —
# свой профиль в приложении Meta и свой токен, даже если аккаунт один и тот же.
THREADS_USER_ID=
THREADS_ACCESS_TOKEN=
# Токены Threads и Instagram бот продлевает сам раз в неделю и хранит в базе
# (таблица app_settings) — вписать их достаточно один раз. Для отчётов по
# рекламе токену Threads нужно разрешение threads_manage_insights, для заявок из
# ответов под постами — threads_read_replies.
#
# Необязательно: тег темы постов в Threads, по умолчанию «шабашка». off —
# без тега.
THREADS_TOPIC_TAG=
# Необязательно: кому в Threads картинка-карточка: ads (по умолчанию, только
# рекламе), all или none.
THREADS_CARDS=

# Платная реклама (/ad в боте). Пометка первой строкой поста и в канале —
# например, Реклама; по умолчанию её нет. Сколько просмотров за сутки обещано
# рекламодателю (по умолчанию 1000, как в шапке профиля Threads) и через сколько
# часов проверять, не отстаёт ли реклама (по умолчанию 6).
AD_LABEL=
AD_VIEWS_GOAL=
AD_WARN_HOURS=

# Автоимпорт вакансий из чужого Telegram-канала (без ручной пересылки), см.
# README, раздел «Автоимпорт из канала-источника». Без этих переменных бот
# работает как раньше — только по тому, что прислали ему лично.
#
# TELEGRAM_API_ID и TELEGRAM_API_HASH — с https://my.telegram.org (API development
# tools), от аккаунта, который подписан на канал-источник.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Строка сессии — получить один раз командой `npm run telegram-login` (см. README).
TELEGRAM_SESSION_STRING=
# Канал(ы)-источник: @username или числовой id, через запятую, если несколько.
SOURCE_CHANNEL=
# Что публиковать из канала: список типов через запятую (vacancy,order,board)
# или all — всё, кроме явного мусора. По умолчанию all. Учтите, что фильтр стоит
# ПОСЛЕ модели: за отброшенный тип разбор уже оплачен из суточной нормы токенов.
SOURCE_LISTING_TYPE=all
# Необязательно: куда слать отчёт о публикации (карточка, кнопка удаления,
# статус по соцсетям). По умолчанию — первый ID из TELEGRAM_ADMIN_IDS.
SOURCE_REPORT_CHAT_ID=
# Необязательно: не публиковать объявления старше стольких часов, по умолчанию 12.
SOURCE_MAX_AGE_HOURS=
# Необязательно: как часто опрашивать источники, в секундах; по умолчанию 60.
SOURCE_POLL_SECONDS=
